# VaneLoop Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file to a new file named .env in the root directory.
# 2. Fill in the values below based on your environment.
# 3. DO NOT commit the .env file to your repository.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# API Backend Configuration
# -----------------------------------------------------------------------------

# 1. Store Mode (Database Toggle)
# The application will use this to determine the storage backend.
# Use 'cassandra' in production. SQLite is for local development only.
# Set to 'sqlite' for local development without Cassandra/Redis.
VANELOOP_STORE=cassandra
CORS_ALLOW_ORIGINS=http://localhost:3000

# 2. Redis Configuration (Hot Path)
# Upstash/Redis connection URL.
# Example: redis://default:your_password@your-upstash-url:port
REDIS_URL=redis://localhost:6379

# 3. Cassandra Configuration (Cold Path)
# Connection details for your Cassandra/Astra DB instance.
# For standard Cassandra: Provide the IP or hostname.
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_KEYSPACE=vaneloop
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=

# 4. Astra DB Configuration (Alternative to standard Cassandra)
# Base64-encoded Astra Secure Connect Bundle. Keep it in the host's secret manager.
# Alternatively mount it as CASSANDRA_SECURE_CONNECT_BUNDLE_PATH.
ASTRA_DB_BUNDLE_BASE64=

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------

# API Base URL
# This tells the frontend where to send its API requests.
# Local development: http://localhost:8000
# Production: The public URL of your deployed API service (e.g., https://api.yourdomain.com)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API. Set this to the exact Vercel URL(s).
CORS_ALLOW_ORIGINS=http://localhost:3000

# Replay configuration. The raw C-MAPSS files are mounted or downloaded by the deploy job,
# never committed or baked into the image.
REPLAY_MODE=train
REPLAY_TICK_MS=1000
MODEL_DIR=ml/artifacts
