{
  "openapi": "3.1.0",
  "info": {
    "title": "VaneLoop API",
    "description": "Fleet health dashboard API. Data is simulated NASA C-MAPSS replay. Not for real aircraft maintenance decisions.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/fleet": {
      "get": {
        "summary": "Get Fleet",
        "description": "Return all engine statuses and fleet counts. Source: Redis hot path.",
        "operationId": "get_fleet_api_v1_fleet_get",
        "parameters": [
          {
            "name": "dataset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "FD001",
              "title": "Dataset"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Nominal|Warning|Critical",
              "title": "State"
            },
            "description": "Filter by Nominal|Warning|Critical"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "rul_asc|rul_desc|id|cycle",
              "default": "rul_asc",
              "title": "Sort"
            },
            "description": "rul_asc|rul_desc|id|cycle"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FleetResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/engines/{dataset}/{unit}": {
      "get": {
        "summary": "Get Engine Status",
        "description": "Single engine current status from Redis.",
        "operationId": "get_engine_status_api_v1_engines__dataset___unit__get",
        "parameters": [
          {
            "name": "dataset",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dataset"
            }
          },
          {
            "name": "unit",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Unit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
